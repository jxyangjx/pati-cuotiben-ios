# Copy to gateway/.env and fill these on the machine that runs the gateway.
# Do not commit gateway/.env. Leave the keys empty in git.

# fake | openai | anthropic | tongyi | zhipu | deepseek
INFERENCE_PROVIDER=fake

# Optional. Empty uses that provider's preset base URL and model.
INFERENCE_BASE_URL=
INFERENCE_MODEL=

# Provider key. Required for every provider except fake. Never commit a real key.
INFERENCE_API_KEY=

# Optional bearer token the iOS app sends. Store the same value in the app Keychain.
GATEWAY_API_KEY=

GATEWAY_HOST=127.0.0.1
PORT=8787
